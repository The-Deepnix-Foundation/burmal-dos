{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/burmal-dos/fastfetch-logo.txt",
    "color": {
      "1": "green"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "magenta",
      "title": "green"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS",
      "format": "{name} {version} ({arch})"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "locale",
    "colors"
  ]
}
